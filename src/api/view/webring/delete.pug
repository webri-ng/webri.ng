extends ../layout.pug

block title
	| Delete Webring | webri.ng

block content
	h1 Delete Webring
	p Are you sure you want to delete this webring?
	div
		button(type='button' onclick='deleteWebring(\'' + webring.url + '\')') Delete Webring!
		button(type='button' onclick='cancelDelete(\'' + webring.url + '\')') No! Take me back!
	div#delete-webring-error-message.error-message(aria-live='polite')
