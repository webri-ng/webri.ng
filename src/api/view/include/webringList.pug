ul.webring-list
	each webring in webrings
		li
			h3: a(href='/webring/' + encodeURIComponent(webring.url)) #{webring.name}
			p.description
				if webring.description.length > 100
					| #{webring.description.substring(0, 100)}...
				else
					| #{webring.description}

if totalPages > 1
	nav.webring-list-navigation(aria-label='Page navigation')
		ul
			if currentPage > 1
				li: a(href='/user?page=' + previousPageNumber) Previous Page
			if currentPage < totalPages
				li: a(href='/user?page=' + nextPageNumber) Next Page
