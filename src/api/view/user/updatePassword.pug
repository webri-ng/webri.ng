extends ../layout.pug

block title
	| Update Password | webri.ng

block content
	h1 Update Password
	form#update-password-form
		div.form-field
			label(for='current-password') Current Password:
			input#current-password(type='password' name='currentPassword' minlength=2 maxlength=128 required='')
		div.form-field
			label(for='new-password') New Password:
			input#new-password(type='password' name='newPassword' minlength=2 maxlength=128 required='')
		div.form-field
			label(for='confirm-password') Confirm Password:
			input#confirm-password(type='password' name='confirmPassword' minlength=2 maxlength=128 required='')
		div.form-buttons
			button(type='button', onclick="updatePassword()") Update Password
		div#update-password-error-message.error-message(aria-live='polite')
